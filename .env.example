# ─────────────────────────────────────────────────────────────────────────────
# OLX Hunter AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for analysis. Latest fast multimodal model recommended.
# See full list: https://ai.google.dev/models/gemini
GEMINI_MODEL_NAME=gemini-3.1-flash-lite-preview

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token here.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal chat ID or a group/channel ID to receive alerts.
# Tip: send a message to your bot and check:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here
